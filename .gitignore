.venv/
__pycache__/
*.pyc

# Harness output: report.json, junit.xml, screenshots
reports/

# .NET build output, and the NuGet cache `make flaui-*` keeps in the checkout
image/flaui-mcp-server/bin/
image/flaui-mcp-server/obj/
.cache/

# `make flaui-zip` / `make example-build` output
dist/
example-app/build/

# Scratch space for sources that must not be committed. Inside the checkout so
# it is to hand, ignored so it cannot be published by accident.
temp/
