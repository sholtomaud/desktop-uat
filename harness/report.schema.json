{
  "$defs": {
    "BuildRef": {
      "properties": {
        "s3_uri": {
          "title": "S3 Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "artifactory_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifactory Uri"
        }
      },
      "required": [
        "s3_uri",
        "sha256",
        "name"
      ],
      "title": "BuildRef",
      "type": "object"
    },
    "CriterionResult": {
      "properties": {
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "visual",
            "deterministic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "enum": [
            "agent",
            "deterministic",
            "harness"
          ],
          "title": "Source",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "kind",
        "status",
        "source",
        "observation"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "s3_uri": {
          "title": "S3 Uri",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "s3_uri",
        "local_path",
        "captured_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor",
            "cosmetic"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "severity",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ScenarioResult": {
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "title": "Ended At",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "session_user_id": {
          "title": "Session User Id",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionResult"
          },
          "title": "Criteria",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "agent_summary": {
          "default": "",
          "title": "Agent Summary",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "scenario_id",
        "title",
        "status",
        "started_at",
        "ended_at",
        "duration_seconds",
        "session_user_id"
      ],
      "title": "ScenarioResult",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "git_ref": {
      "title": "Git Ref",
      "type": "string"
    },
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "build": {
      "$ref": "#/$defs/BuildRef"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    },
    "totals": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Totals",
      "type": "object"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      },
      "title": "Scenarios",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "git_ref",
    "git_sha",
    "build",
    "model_id",
    "started_at",
    "ended_at",
    "status",
    "totals",
    "scenarios"
  ],
  "title": "RunReport",
  "type": "object"
}